    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "express": "5.3.0",
    "drizzle-orm": "1.0.0-beta.22",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-beta.22"
  }
}
"
`;

exports[`renderApi for Postgres > writes src/app.js 1`] = `
"import express from 'express';
import { ZodError } from 'zod';
import { router as users } from './routes/users.js';
import { router as events } from './routes/events.js';

export const app = express();

app.use(express.json());
app.use('/users', users);
app.use('/events', events);

app.use((err, req, res, next) => {
  if (err instanceof ZodError) {
    return res.status(400).json({ message: 'Invalid request body', issues: err.issues });
  }
  if (err.status >= 400 && err.status < 500) {
    return res.status(err.status).json({ message: err.message });
  }
  console.error(err);
  res.status(500).json({ message: 'Internal Server Error' });
});
"
`;

exports[`renderApi for Postgres > writes src/db/index.js 1`] = `
"import { drizzle } from 'drizzle-orm/node-postgres';

export const db = drizzle(process.env.DATABASE_URL);
"
`;

exports[`renderApi for Postgres > writes src/db/schema.js 1`] = `
"import { bigserial, integer, jsonb, numeric, pgEnum, pgTable, serial, timestamp, uuid, varchar } from 'drizzle-orm/pg-core';

export const userRoleEnum = pgEnum("user_role", ["admin","member"]);

export const users = pgTable("users", {
  id: serial("id").primaryKey(),
  email: varchar("email", { length: 50 }).notNull().unique(),
  role: userRoleEnum("role").notNull(),
  balance: numeric("balance", { precision: 10, scale: 2 }),
  createdAt: timestamp("created_at", { withTimezone: true }).notNull(),
  settings: jsonb("settings"),
});

export const events = pgTable("events", {
  id: bigserial("id", { mode: 'number' }).primaryKey(),
  userId: integer("user_id").notNull().references(() => users.id),
  externalId: uuid("external_id").notNull(),
});
"
`;

exports[`renderApi for Postgres > writes src/index.js 1`] = `
