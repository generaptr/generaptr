    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline": "drizzle-kit generate && node --env-file-if-exists=.env scripts/baseline.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "drizzle-orm": "1.0.0-rc.5",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.5"
  }
}
"
`;

exports[`renderApi for Postgres > writes scripts/baseline.js 1`] = `
"// Records the first migration in ./drizzle as applied, without running it. Run this once, on the
// database that generaptr read: its tables exist already. A fresh database runs \`npm run db:migrate\`.
import { drizzle } from 'drizzle-orm/node-postgres';
import { migrate } from 'drizzle-orm/node-postgres/migrator';

const errors = {
  databaseMigrations: 'The database already has applied migrations. Use \`npm run db:migrate\` instead.',
  localMigrations: './drizzle has more than one migration. Baseline records only the first; remove the others, then run it again.',
};

const db = drizzle(process.env.DATABASE_URL);
try {
  const result = await migrate(db, { migrationsFolder: './drizzle', init: true });
  if (result?.exitCode) {
    console.error(errors[result.exitCode]);
    process.exitCode = 1;
  } else {
    console.log('Recorded the first migration as applied. No table changed.');
  }
} finally {
  await db.$client.end();
}
"
`;

exports[`renderApi for Postgres > writes src/app.js 1`] = `
"import express from 'express';
import { ZodError } from 'zod';
import { router as users } from './routes/users.js';
import { router as events } from './routes/events.js';

export const app = express();

app.use(express.json());
app.use('/users', users);
app.use('/events', events);

app.use((err, req, res, next) => {
  if (err instanceof ZodError) {
    return res.status(400).json({ message: 'Invalid request body', issues: err.issues });
  }
  if (err.status >= 400 && err.status < 500) {
    return res.status(err.status).json({ message: err.message });
  }
  console.error(err);
  res.status(500).json({ message: 'Internal Server Error' });
});
"
`;

exports[`renderApi for Postgres > writes src/db/index.js 1`] = `
"import { drizzle } from 'drizzle-orm/node-postgres';
import { relations } from './relations.js';

export const db = drizzle(process.env.DATABASE_URL, { relations });
"
`;

exports[`renderApi for Postgres > writes src/db/relations.js 1`] = `
"import { defineRelations } from 'drizzle-orm';
import * as schema from './schema.js';

export const relations = defineRelations(schema, (r) => ({
  users: {
    events: r.many.events({ from: r.users.id, to: r.events.userId }),
  },
  events: {
    user: r.one.users({ from: r.events.userId, to: r.users.id }),
  },
}));
"
`;

exports[`renderApi for Postgres > writes src/db/schema.js 1`] = `
"import { bigserial, foreignKey, integer, jsonb, numeric, pgEnum, pgTable, serial, timestamp, unique, uuid, varchar } from 'drizzle-orm/pg-core';

export const userRoleEnum = pgEnum("user_role", ["admin","member"]);

export const users = pgTable("users", {
  id: serial("id").primaryKey(),
  email: varchar("email", { length: 50 }).notNull(),
  role: userRoleEnum("role").notNull(),
  balance: numeric("balance", { precision: 10, scale: 2 }),
  createdAt: timestamp("created_at", { withTimezone: true }).notNull(),
  settings: jsonb("settings"),
}, (table) => [
  unique("users_email_key").on(table.email),
]);

export const events = pgTable("events", {
  id: bigserial("id", { mode: 'number' }).primaryKey(),
  userId: integer("user_id").notNull(),
  externalId: uuid("external_id").notNull(),
}, (table) => [
  foreignKey({ name: "events_user_id_fkey", columns: [table.userId], foreignColumns: [users.id] }).onDelete("set null"),
]);
"
`;

exports[`renderApi for Postgres > writes src/index.js 1`] = `
"import { app } from './app.js';

const port = Number(process.env.PORT) || 3000;
app.listen(port, () => console.log(\`Listening on port \${port}\`));
"
`;

exports[`renderApi for Postgres > writes src/routes/events.js 1`] = `
"import { eq } from 'drizzle-orm';
import { createSchemaFactory } from 'drizzle-orm/zod';
import { Router } from 'express';
import { db } from '../db/index.js';
import { events } from '../db/schema.js';

// JSON carries dates as ISO strings.
const { createInsertSchema, createUpdateSchema } = createSchemaFactory({ coerce: { date: true } });
const insertSchema = createInsertSchema(events);
const updateSchema = createUpdateSchema(events);
const byId = (req) => eq(events.id, Number(req.params.id));
const includes = {"user":true};

// \`?with=a,b\` names the relations to include, as defined in src/db/relations.js.
const withRelations = (req) => {
  const names = String(req.query.with ?? '').split(',').map((name) => name.trim()).filter(Boolean);
  const unknown = names.find((name) => !Object.hasOwn(includes, name));
  if (unknown !== undefined) {
    const message = \`Unknown relation "\${unknown}". Use: \${Object.keys(includes).join(', ') || 'none'}\`;
    throw Object.assign(new Error(message), { status: 400 });
  }
  return Object.fromEntries(names.map((name) => [name, includes[name]]));
};

export const router = Router();

router.get('/', async (req, res) => {
  const limit = Math.min(Number(req.query.limit) || 20, 100);
  const offset = Number(req.query.offset) || 0;
  res.json(await db.query.events.findMany({ limit, offset, with: withRelations(req) }));
});

router.get('/:id', async (req, res) => {
  const row = await db.query.events.findFirst({ where: { id: Number(req.params.id) }, with: withRelations(req) });
  if (!row) {
    return res.status(404).json({ message: 'Not found' });
  }
  res.json(row);
});

router.post('/', async (req, res) => {
  const [created] = await db.insert(events).values(insertSchema.parse(req.body)).returning({ id: events.id });
  res.status(201).location(\`\${req.baseUrl}/\${created.id}\`).json(created);
});

router.put('/:id', async (req, res) => {
  await db.update(events).set(updateSchema.parse(req.body)).where(byId(req));
  res.status(204).end();
});

router.delete('/:id', async (req, res) => {
  await db.delete(events).where(byId(req));
  res.status(204).end();
});
"
`;

exports[`renderApi for Postgres > writes src/routes/users.js 1`] = `
"import { eq } from 'drizzle-orm';
import { createSchemaFactory } from 'drizzle-orm/zod';
import { Router } from 'express';
import { db } from '../db/index.js';
import { users } from '../db/schema.js';

// JSON carries dates as ISO strings.
const { createInsertSchema, createUpdateSchema } = createSchemaFactory({ coerce: { date: true } });
const insertSchema = createInsertSchema(users);
const updateSchema = createUpdateSchema(users);
const byId = (req) => eq(users.id, Number(req.params.id));
const includes = {"events":{"limit":100}};

// \`?with=a,b\` names the relations to include, as defined in src/db/relations.js.
const withRelations = (req) => {
  const names = String(req.query.with ?? '').split(',').map((name) => name.trim()).filter(Boolean);
  const unknown = names.find((name) => !Object.hasOwn(includes, name));
  if (unknown !== undefined) {
    const message = \`Unknown relation "\${unknown}". Use: \${Object.keys(includes).join(', ') || 'none'}\`;
    throw Object.assign(new Error(message), { status: 400 });
  }
  return Object.fromEntries(names.map((name) => [name, includes[name]]));
};

export const router = Router();

router.get('/', async (req, res) => {
  const limit = Math.min(Number(req.query.limit) || 20, 100);
  const offset = Number(req.query.offset) || 0;
  res.json(await db.query.users.findMany({ limit, offset, with: withRelations(req) }));
});

router.get('/:id', async (req, res) => {
  const row = await db.query.users.findFirst({ where: { id: Number(req.params.id) }, with: withRelations(req) });
  if (!row) {
    return res.status(404).json({ message: 'Not found' });
  }
  res.json(row);
});

router.post('/', async (req, res) => {
  const [created] = await db.insert(users).values(insertSchema.parse(req.body)).returning({ id: users.id });
  res.status(201).location(\`\${req.baseUrl}/\${created.id}\`).json(created);
});

router.put('/:id', async (req, res) => {
  await db.update(users).set(updateSchema.parse(req.body)).where(byId(req));
  res.status(204).end();
});

router.delete('/:id', async (req, res) => {
  await db.delete(users).where(byId(req));
  res.status(204).end();
});
"
`;
