exports[`renderApi > writes drizzle.config.js 1`] = `
"import { defineConfig } from 'drizzle-kit';

try {
  process.loadEnvFile();
} catch {}

export default defineConfig({
  dialect: 'mysql',
  schema: './src/db/schema.js',
  out: './drizzle',
  dbCredentials: { url: process.env.DATABASE_URL },
});
"
`;

