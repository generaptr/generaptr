{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": [
      "es2023",
      "esnext.disposable"
    ],
    "types": [
      "node",
      "vitest/globals"
    ],
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "declaration": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "../build"
  },
  "include": [
    "../src/**/*",
    "**/*"
  ]
}
