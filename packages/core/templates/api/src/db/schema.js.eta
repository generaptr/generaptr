import { <%= it.builders %> } from 'drizzle-orm/mysql-core';
<% for (const table of it.tables) { %>
export const <%= table.name %> = mysqlTable(<%= table.table %>, {
<% for (const column of table.columns) { -%>
  <%= column.key %>: <%= column.chain %>,
<% } -%>
}<% if (table.primaryKeys) { %>, (table) => [primaryKey({ columns: [<%= table.primaryKeys %>] })]<% } %>);
<% } -%>
