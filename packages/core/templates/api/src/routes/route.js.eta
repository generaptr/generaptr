import { eq } from 'drizzle-orm';
import { createSchemaFactory } from 'drizzle-orm/zod';
import { Router } from 'express';
import { db } from '../db/index.js';
import { <%= it.entity %> } from '../db/schema.js';

// JSON carries dates as ISO strings.
const { createInsertSchema, createUpdateSchema } = createSchemaFactory({ coerce: { date: true } });
const insertSchema = createInsertSchema(<%= it.entity %>);
const updateSchema = createUpdateSchema(<%= it.entity %>);
const byId = (req) => eq(<%= it.entity %>.<%= it.key %>, <%= it.id %>);
const relationNames = <%= it.relations %>;

// `?with=a,b` names the relations to include, as defined in src/db/relations.js.
const withRelations = (req) => {
  const names = String(req.query.with ?? '').split(',').map((name) => name.trim()).filter(Boolean);
  const unknown = names.find((name) => !relationNames.includes(name));
  if (unknown !== undefined) {
    const message = `Unknown relation "${unknown}". Use: ${relationNames.join(', ') || 'none'}`;
    throw Object.assign(new Error(message), { status: 400 });
  }
  return Object.fromEntries(names.map((name) => [name, true]));
};

export const router = Router();

router.get('/', async (req, res) => {
  const limit = Math.min(Number(req.query.limit) || 20, 100);
  const offset = Number(req.query.offset) || 0;
  res.json(await db.query.<%= it.entity %>.findMany({ limit, offset, with: withRelations(req) }));
});

router.get('/:id', async (req, res) => {
  const row = await db.query.<%= it.entity %>.findFirst({ where: { <%= it.key %>: <%= it.id %> }, with: withRelations(req) });
  if (!row) {
    return res.status(404).json({ message: 'Not found' });
  }
  res.json(row);
});

router.post('/', async (req, res) => {
  const [created] = await db.insert(<%= it.entity %>).values(insertSchema.parse(req.body)).<%= it.returning %>;
  res.status(201).location(`${req.baseUrl}/${created.<%= it.key %>}`).json(created);
});

router.put('/:id', async (req, res) => {
  await db.update(<%= it.entity %>).set(updateSchema.parse(req.body)).where(byId(req));
  res.status(204).end();
});

router.delete('/:id', async (req, res) => {
  await db.delete(<%= it.entity %>).where(byId(req));
  res.status(204).end();
});
